# Local development only. Copy to `.env` (git-ignored) and adjust.
#
# Production never reads this file: inject configuration and secrets at runtime
# (see docu/deployment.md). In production, AUTH_SECRET, PUBLIC_ORIGIN and an
# absolute DATABASE_PATH are required and startup fails without them.
#
# NODE_ENV is set by the npm scripts (`pnpm dev` = development, `pnpm start` = production)
# and deliberately not configured here, so a copied .env cannot switch modes.

# Interface and port of the API server. Keep 127.0.0.1 unless you know why not.
HOST=127.0.0.1
PORT=3000

# Origin the browser uses. With `pnpm dev` this is the Vite dev server.
PUBLIC_ORIGIN=http://localhost:5173

# SQLite file. Relative paths resolve against the repository root.
DATABASE_PATH=.var/vergissmeinnicht.sqlite

# Session/auth signing secret, at least 32 characters. Generate with:
#   openssl rand -base64 32
# If unset in development, a per-process secret is generated (sessions reset on restart).
# A value containing "replace-me" is always rejected.
# AUTH_SECRET=replace-me

# fatal | error | warn | info | debug | trace | silent  (production: no debug/trace)
LOG_LEVEL=debug
