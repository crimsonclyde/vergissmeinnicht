# Runtime configuration of the app container (non-secret values). Copy to vergissmeinnicht.env.
# Secrets (AUTH_SECRET, DATA_ENCRYPTION_KEY, SMTP password) come from Docker secrets, see compose.yml.
# All variables: docu/deployment.md.

# Exactly the origin users open in the browser (https).
PUBLIC_ORIGIN=https://vmn.example.org

# Outgoing email for invitations and account recovery.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USER=vergissmeinnicht
# With a user, also add an smtp_password secret and SMTP_PASSWORD_FILE=/run/secrets/smtp_password.
MAIL_FROM_ADDRESS=noreply@vmn.example.org
MAIL_FROM_NAME=Vergissmeinnicht

LOG_LEVEL=info
INVITATION_TTL_HOURS=72

# Link to the source of the running version (AGPL-3.0 §13); change it if you modified the code.
# SOURCE_CODE_URL=https://github.com/crimsonclyde/vergissmeinnicht
