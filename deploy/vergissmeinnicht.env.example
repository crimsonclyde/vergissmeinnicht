# Runtime configuration of the app container (non-secret values). Copy to vergissmeinnicht.env.
# Secrets (AUTH_SECRET, DATA_ENCRYPTION_KEY, SMTP password) come from Docker secrets, see compose.yml.
# All variables: docu/deployment.md.

# Exactly the origin users open in the browser (https).
PUBLIC_ORIGIN=https://vmn.example.org

# Outgoing email for invitations and account recovery.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USER=vergissmeinnicht
# With a user, also add an smtp_password secret and SMTP_PASSWORD_FILE=/run/secrets/smtp_password.
MAIL_FROM_ADDRESS=noreply@vmn.example.org
MAIL_FROM_NAME=VergissMeinNicht

LOG_LEVEL=info
INVITATION_TTL_HOURS=72

# Link to the source of the running version (AGPL-3.0 §13); change it if you modified the code.
# SOURCE_CODE_URL=https://github.com/crimsonclyde/vergissmeinnicht

# Automatic backups into /data/backups (verified, 0600). Off unless set; keep the newest N automatic
# backups (manual and pre-migration backups are never deleted). Copy them off the server encrypted.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Global limit of API requests per minute and client address (default 300, range 60–10000). Raise it
# only if many people share one address and you cannot set TRUSTED_PROXIES; sign-in, second factor,
# recovery and other sensitive routes keep their own limits.
# API_RATE_LIMIT_PER_MINUTE=300

# Reminders and notifications need no configuration here: email reminders use the SMTP settings above;
# Telegram is set up by a server admin in the app (Server admin → Notification providers). The server
# then needs outgoing HTTPS to api.telegram.org. The bot token is stored encrypted with
# DATA_ENCRYPTION_KEY.
