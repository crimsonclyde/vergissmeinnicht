 const analyzeRepeatedExtglob = (body, options) => {
+  // VMN GHSA-fc5q-39xc-vjpf mitigation: fail closed for non-literal single branches.
+  // The existing risky-pattern path emits the entire extglob as escaped literal text.
+  // This mandatory guard also applies when callers disable the optional recursion limit.
+  const singleBranches = splitTopLevel(body).map(branch => branch.trim());
+  if (singleBranches.length === 1 && !isPlainBranch(singleBranches[0])) {
+    return { risky: true };
+  }
+
   if (options.maxExtglobRecursion === false) {
     return { risky: false };
   }
