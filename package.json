{
  "name": "vergissmeinnicht",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @vergissmeinnicht/web build",
    "start": "pnpm --filter @vergissmeinnicht/server start",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p . && pnpm -r --parallel typecheck",
    "db:generate": "pnpm --filter @vergissmeinnicht/database db:generate",
    "db:migrate": "pnpm --filter @vergissmeinnicht/database db:migrate",
    "admin:bootstrap": "NODE_ENV=development node --env-file-if-exists=.env apps/server/src/cli/admin-bootstrap.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
